# Пример .env для запуска в Docker на VPS. Скопируйте в .env рядом с docker-compose.yml
# и заполните реальными значениями (файл .env в git не коммитится).

DEBUG=False
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=vc-platform.ru,www.vc-platform.ru
CSRF_TRUSTED_ORIGINS=https://vc-platform.ru,https://www.vc-platform.ru
COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# --- База данных: Postgres в отдельном контейнере (сервис db из docker-compose) ---
DB_ENGINE=postgres
DB_NAME=vc_platform
DB_USER=vc_platform
DB_PASSWORD=change-me-strong-db-password
# ВАЖНО: host = имя сервиса из docker-compose (db), а не localhost.
DB_HOST=db
DB_PORT=5432

# --- Telegram ---
TG_BOT_TOKEN=
TG_BOT_USERNAME=
# На VPS бот работает через long polling — WEBAPP_URL нужен только для Mini App/ссылок.
WEBAPP_URL=https://vc-platform.ru
# Webhook на VPS не используется (polling), но переменная должна существовать.
TG_WEBHOOK_SECRET=not-used-with-polling
ANALYTICS_ADMIN_TG_IDS=

# --- Контейнерное логирование: дублировать логи в stdout (docker logs) ---
LOG_TO_STDOUT=1
