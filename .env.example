# Логирование (см. documentation/logging.md). Все необязательны — значения по умолчанию
# в скобках. Логи пишутся в три файла: logs/web.log, logs/bot.log, logs/db.log.
# LOG_DIR=logs                 # каталог для файлов логов (по умолчанию <проект>/logs)
# LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
# LOG_MAX_BYTES=5242880        # размер файла до ротации, байт (5 МБ)
# LOG_BACKUP_COUNT=5           # сколько ротационных копий хранить
