DEBUG=False
SECRET_KEY=change-me-to-a-long-random-value
# Домены, с которых обслуживается сайт (через запятую, без схемы).
ALLOWED_HOSTS=vc.iedanimk.beget.tech
# Полные origin'ы для CSRF (со схемой https://). Обязательно для POST/AJAX в проде.
CSRF_TRUSTED_ORIGINS=https://vc.iedanimk.beget.tech
# Принудительный редирект http->https на уровне Django (на Beget обычно не нужен,
# т.к. https настраивается в панели; оставить False, если не уверены).
SECURE_SSL_REDIRECT=False

DB_ENGINE=sqlite
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

TG_BOT_TOKEN=
TG_BOT_USERNAME=
# Публичный HTTPS-адрес сайта (нужен для Mini App и ссылок входа из бота).
WEBAPP_URL=https://vc.iedanimk.beget.tech
# Секрет webhook Telegram (на shared-хостинге бот работает через webhook, не polling).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
TG_WEBHOOK_SECRET=change-me-to-a-random-token

# Логирование (см. documentation/logging.md). Все необязательны — значения по умолчанию
# в скобках. Логи пишутся в три файла: logs/web.log, logs/bot.log, logs/db.log.
# LOG_DIR=logs                 # каталог для файлов логов (по умолчанию <проект>/logs)
# LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
# LOG_MAX_BYTES=5242880        # размер файла до ротации, байт (5 МБ)
# LOG_BACKUP_COUNT=5           # сколько ротационных копий хранить
