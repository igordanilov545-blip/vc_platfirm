DEBUG=False
SECRET_KEY=change-me-to-a-long-random-value
# Домены, с которых обслуживается сайт (через запятую, без схемы).
# Основной прод-домен — vc-platform.ru (с SSL). Старый beget-домен оставлен для
# совместимости/резерва, пока указывает на прежний инстанс.
ALLOWED_HOSTS=vc-platform.ru,www.vc-platform.ru,vc.iedanimk.beget.tech,iedanimk.beget.tech
# Полные origin'ы для CSRF (со схемой). Обязательно для POST/AJAX в проде.
CSRF_TRUSTED_ORIGINS=https://vc-platform.ru,https://www.vc-platform.ru,https://vc.iedanimk.beget.tech
# Secure-cookie: True на проде с HTTPS (vc-platform.ru обслуживается по SSL).
COOKIE_SECURE=True
# Принудительный редирект http->https на уровне Django (домен с SSL — включён).
SECURE_SSL_REDIRECT=True

DB_ENGINE=sqlite
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

TG_BOT_TOKEN=
TG_BOT_USERNAME=
# Публичный HTTPS-адрес сайта (нужен для Mini App, ссылок входа из бота и webhook).
WEBAPP_URL=https://vc-platform.ru
# Секрет webhook Telegram (на shared-хостинге бот работает через webhook, не polling).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
TG_WEBHOOK_SECRET=change-me-to-a-random-token

# Логирование (см. documentation/logging.md). Все необязательны — значения по умолчанию
# в скобках. Логи пишутся в три файла: logs/web.log, logs/bot.log, logs/db.log.
# LOG_DIR=logs                 # каталог для файлов логов (по умолчанию <проект>/logs)
# LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
# LOG_MAX_BYTES=5242880        # размер файла до ротации, байт (5 МБ)
# LOG_BACKUP_COUNT=5           # сколько ротационных копий хранить
