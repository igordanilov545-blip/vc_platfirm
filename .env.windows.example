# Local Windows development (HTTP + SQLite).
DEBUG=True
SECRET_KEY=GENERATE_ON_SETUP
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
DB_ENGINE=sqlite

# Optional: development bot's token from @BotFather and username without @.
TG_BOT_TOKEN=
TG_BOT_USERNAME=
# Leave empty for browser-only development. Telegram Mini App requires public HTTPS.
WEBAPP_URL=
# Not required for local long polling.
TG_WEBHOOK_SECRET=
ANALYTICS_ADMIN_TG_IDS=
# Usually detected automatically. Example: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_BIN=
