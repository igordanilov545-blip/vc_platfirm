# Shell-скрипты и серверные конфиги всегда с LF — иначе bash на Linux (Beget)
# спотыкается о \r в shebang, а Passenger — о CRLF в .htaccess.
*.sh              text eol=lf
deploy/htaccess.* text eol=lf
passenger_wsgi.py text eol=lf

# Word-шаблоны — бинарные, git не нормализует переводы строк внутри zip-контейнера.
*.docx binary
